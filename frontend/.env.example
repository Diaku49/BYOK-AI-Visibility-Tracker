# Copy to .env.local and fill in. Never commit real values.
# Only VITE_-prefixed vars reach the browser bundle — keep secrets server-side.

# Base URL for the backend API.
# Unset, the app falls back to the dummy host in shared/api/client.ts.
# Point this at a local backend during development, e.g. http://localhost:8080/api/v1
VITE_API_BASE_URL=https://dummy.byok-tracker.dev/api/v1
