# Copy to .env.local and fill in. Never commit real values.
# Only VITE_-prefixed vars reach the browser bundle — keep secrets server-side.

# Base URL for the backend API.
# The Go server's routes are rooted at / (for example, POST /user/login).
# Unset, the app falls back to http://localhost:8080.
VITE_API_BASE_URL=http://localhost:8080
